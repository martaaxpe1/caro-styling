<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The fonts bundled in Resources/Fonts, so the app can use them by name. -->
	<key>UIAppFonts</key>
	<array>
		<string>Newsreader.ttf</string>
		<string>Newsreader-Italic.ttf</string>
		<string>Inter.ttf</string>
	</array>
	<!-- Allow plain http to the server on your Mac (localhost and .local names only).
	     The online server on Render (T8) uses https, which needs no exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Caro uses only the iPhone's standard encryption (https), so App Store Connect does not
	     ask about export rules for every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The line the iPhone shows when it first asks for the camera (Take photos, T5).
	     Choose from library needs no permission: the photo picker only shares what you pick. -->
	<key>NSCameraUsageDescription</key>
	<string>Caro uses the camera to photograph the pieces you keep.</string>
	<!-- The line the iPhone shows when it asks to use your local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Caro connects to the server on your Mac while the app is being built.</string>
	<!-- The Keychain group the app shares with its share extension (T10): the session token
	     and the server address. Xcode fills in the team. Also in Caro.entitlements. -->
	<key>CaroKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.carostyling.shared</string>
	<!-- The launch screen is plain paper, so the app opens without a white flash. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
