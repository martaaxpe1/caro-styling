{
  "name": "caro-server",
  "version": "0.1.0",
  "description": "The server for Caro Styling: accounts, wardrobes, photos and the AI calls.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "spike:check": "node --env-file-if-exists=.env spike/check.js",
    "spike:details": "node --env-file-if-exists=.env spike/1-details.js",
    "spike:looks": "node --env-file-if-exists=.env spike/2-looks.js",
    "spike:inspirations": "node --env-file-if-exists=.env spike/3-inspirations.js",
    "spike:stores": "node --env-file-if-exists=.env spike/4-stores.js",
    "spike:year": "node --env-file-if-exists=.env spike/5-year.js",
    "spike:review": "node --env-file-if-exists=.env spike/review.js",
    "spike:costs": "node --env-file-if-exists=.env spike/costs.js"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "express": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
