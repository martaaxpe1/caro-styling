# Copy this file to .env and fill in the values. Never commit .env.
# Locally, every line can stay as it is: the server runs without a .env file.

# The port the server listens on. The app expects 3000 in development.
PORT=3000

# "production" online (set in render.yaml). Locally, leave it empty.
NODE_ENV=

# The Claude API key, from console.anthropic.com (T1). Only ever here, never in the app or in Git.
ANTHROPIC_API_KEY=

# Your email. npm run seed makes it the admin account. Only here, never in Git.
ADMIN_EMAIL=

# Where the database, the photos and (online) the backups live. Locally, leave it empty: server/data/.
# Online, Render's disk: /var/data (set in render.yaml).
DATA_DIR=

# Pretend today is another day, like 2026-10-30, to test seasons and expiry dates.
# Empty uses the real date. Ignored online.
DEV_TODAY=

# Real emails through Resend, online only. Locally, leave both empty: emails print in the terminal.
# Online, in Render's environment settings: the key from Resend, and a sender on a domain
# verified in Resend, like Caro <caro@yourdomain.com>.
RESEND_API_KEY=
EMAIL_FROM=
