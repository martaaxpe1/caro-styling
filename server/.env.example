# Copy this file to .env and fill in the values. Never commit .env.
# Locally, every line can stay as it is: the server runs without a .env file.

# The port the server listens on. The app expects 3000 in development.
PORT=3000

# Set to "production" online (T8). Locally, leave it empty.
NODE_ENV=

# The Claude API key, from console.anthropic.com (T1). Only ever here, never in the app or in Git.
ANTHROPIC_API_KEY=

# Your email. npm run seed makes it the admin account. Only here, never in Git.
ADMIN_EMAIL=

# Where the database (and later the photos) live. Locally, leave it empty: server/data/.
# Online (T8), the path to Render's disk.
DATA_DIR=

# Pretend today is another day, like 2026-10-30, to test seasons and expiry dates.
# Empty uses the real date. Ignored online.
DEV_TODAY=

# Later tickets add these:
# RESEND_API_KEY=         T8, real emails. Empty locally: emails print in the terminal.
# EMAIL_FROM=             T8, a sender on a domain verified in Resend.
