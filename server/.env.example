# Copy this file to .env and fill in the values. Never commit .env.
# Locally, every line can stay as it is: the server runs without a .env file.

# The port the server listens on. The app expects 3000 in development.
PORT=3000

# Set to "production" online (T8). Locally, leave it empty.
NODE_ENV=

# Later tickets add these:
# ANTHROPIC_API_KEY=      T1, the Claude API key. Only ever here, never in the app.
# DATA_DIR=               T2, where the database and photos live.
# DEV_TODAY=              T2, a date like 2026-10-30 to pretend it is that day.
# RESEND_API_KEY=         T8, real emails. Empty locally: emails print in the terminal.
# EMAIL_FROM=             T8, a sender on a domain verified in Resend.
